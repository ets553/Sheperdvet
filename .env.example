# SyncroMSP subdomain (from https://<subdomain>.syncromsp.com)
SYNCRO_SUBDOMAIN=your-subdomain

# SyncroMSP API token. Generate at: Admin > API Tokens
# Token must have the permissions you intend to use (e.g. Customers - List/Create,
# Tickets - List/Create/Edit, etc.)
SYNCRO_API_KEY=your-api-key

# Optional: override the full base URL (otherwise derived from SYNCRO_SUBDOMAIN)
# SYNCRO_BASE_URL=https://your-subdomain.syncromsp.com/api/v1

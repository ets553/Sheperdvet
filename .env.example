# Base URL of the Shepherd API. Override if your tenant uses a different host.
SHEPHERD_BASE_URL=https://api.shepherd.vet

# API key issued by Shepherd. Sent as `Authorization: Bearer <key>` by default.
SHEPHERD_API_KEY=

# Optional: override the auth scheme. Default is "Bearer".
# Examples: "Bearer", "Token", "ApiKey"
SHEPHERD_AUTH_SCHEME=Bearer

# Optional: header name to send the API key in. Default is "Authorization".
# If set to anything other than "Authorization", the value is sent as-is
# (no scheme prefix) — useful for `X-API-Key`-style headers.
SHEPHERD_AUTH_HEADER=Authorization

# Optional: request timeout in milliseconds. Default 30000.
SHEPHERD_TIMEOUT_MS=30000
